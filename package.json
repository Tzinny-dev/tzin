{
  "name": "@carlos-tzin/tzin",
  "version": "1.0.2",
  "description": "Contract-first TypeScript framework. Types that scale, realtime channels with presence, and an MCP server for every API.",
  "license": "MIT",
  "author": "The tzin authors",
  "keywords": [
    "typescript",
    "framework",
    "contract-first",
    "typebox",
    "openapi",
    "mcp",
    "realtime",
    "websockets",
    "sse",
    "presence",
    "channels",
    "http",
    "api"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tzinny-dev/tzin.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client-browser": {
      "types": "./dist/client-browser.d.ts",
      "default": "./dist/client-browser.js"
    },
    "./bus": {
      "types": "./dist/bus.d.ts",
      "default": "./dist/bus.js"
    },
    "./ws": {
      "types": "./dist/ws.d.ts",
      "default": "./dist/ws.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "default": "./dist/test.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./jobs": {
      "types": "./dist/jobs.d.ts",
      "default": "./dist/jobs.js"
    },
    "./log": {
      "types": "./dist/log.d.ts",
      "default": "./dist/log.js"
    },
    "./rate-limit": {
      "types": "./dist/rate-limit.d.ts",
      "default": "./dist/rate-limit.js"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "default": "./dist/cache.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:ours": "tsc -p bench/tsconfig.ours.json --noEmit --extendedDiagnostics",
    "typecheck:hono": "tsc -p bench/tsconfig.hono.json --noEmit --extendedDiagnostics",
    "probe:mcp": "node scripts/mcp-client.mjs",
    "probe:workers": "node scripts/workers-probe.mjs",
    "bench:lookup": "tsx bench/lookup.bench.mjs",
    "bench:http": "tsx bench/http.bench.mjs",
    "bench:pipeline": "tsx bench/pipeline.bench.mjs",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.1",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autocannon": "^8.0.0",
    "esbuild": "^0.28.0",
    "express": "^5.2.1",
    "hono": "^4.0.0",
    "miniflare": "^5.20260820.0-alpha",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
